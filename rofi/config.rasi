@theme "/dev/null"


configuration {
	display-drun: "🚀 LAUNCH";	
	font: "JetBrainsMono Nerd Font Medium 12";
	show-icons: true;
	drun-desplay-format: "{icon} {name}";
}

* {
    /* -------------------- Base Colors -------------------- */
background: rgba(18, 18, 18, 75%);                   /* #121212 - primary black */
normal-background: rgba(0, 0, 0, 0%);
alternate-normal-background: rgba(0, 0, 0, 0%);  /* #1c1c1c - slightly lighter black */
border-color: rgba(67, 76, 94, 100%);                /* #434C5E - subtle border */

foreground: rgba(216, 222, 233, 100%);               /* #D8DEE9 - soft white */
normal-foreground: @foreground;
alternate-normal-foreground: @foreground;
lightfg: rgba(146, 192, 252, 1);                   /* #5E81AC - blue accent */

/* -------------------- Selected -------------------- */
selected-normal-background: rgba(146, 192, 252, 1);  /* #5E81AC */
selected-normal-foreground: rgba(236, 239, 244, 100%); /* #ECEFF4 */

/* -------------------- Active -------------------- */
active-background: rgba(59, 66, 82, 17%);             /* subtle dark overlay */
active-foreground: rgba(129, 161, 193, 100%);         /* #81A1C1 - lighter blue */
selected-active-background: rgba(129, 161, 193, 100%); /* #81A1C1 */
selected-active-foreground: rgba(236, 239, 244, 100%); /* #ECEFF4 */
alternate-active-background: rgba(28, 28, 28, 89%);   /* slightly lighter black */
alternate-active-foreground: @active-foreground;

/* -------------------- Urgent / Red -------------------- */
red: rgba(191, 97, 106, 100%);                        /* #BF616A */
urgent-foreground: rgba(191, 97, 106, 100%);          /* #BF616A */
selected-urgent-foreground: rgba(236, 239, 244, 100%); /* #ECEFF4 */
urgent-background: rgba(28, 28, 28, 90%);             /* slightly lighter black */
alternate-urgent-background: rgba(28, 28, 28, 90%);   /* same */
selected-urgent-background: rgba(191, 97, 106, 100%); /* #BF616A */
alternate-urgent-foreground: @urgent-foreground;

/* -------------------- Light / Extras -------------------- */
lightbg: rgba(229, 233, 240, 100%);                   /* minimal highlights if needed */
separatorcolor: rgba(59, 66, 82, 100%);               /* subtle separator */
background-color: rgba(0, 0, 0, 0%);                  /* fully transparent bg for special items */
spacing: 2;

}

window {
    background-color: @background;
    border: none;
    border-right: 5;

    padding:          5;
    location: west;
    height: 100%;
    width: 40%;
}
mainbox {
    border:  0;
    padding: 0;
}
message {
    border:       2px 0px 0px ;
    border-color: @separatorcolor;
    padding:      1px ;
}
textbox {
    text-color: @foreground;
}
listview {
    fixed-height: 0;
    border:       2px 0px 0px ;
    border-color: @separatorcolor;
    spacing:      5px ;
    scrollbar:    true;
    padding:      2px 0px 0px ;
}
element {
    border:  0;
    padding: 3px ;
}
element-text {
    background-color: inherit;
    text-color:       inherit;
}
element-icon {
    size: 2 ch;
    margin: 0 10px 0 0;
}
element.normal.normal {
    background-color: @normal-background;
    text-color:       @normal-foreground;
}
element.normal.urgent {
    background-color: @urgent-background;
    text-color:       @urgent-foreground;
}
element.normal.active {
    background-color: @active-background;
    text-color:       @active-foreground;
}
element.selected.normal {
    border: 1px;
    border-color: @selected-normal-background;
    text-color:       @selected-normal-background;
}
element.selected.urgent {
    background-color: @selected-urgent-background;
    text-color:       @selected-urgent-foreground;
}
element.selected.active {
    background-color: @selected-active-background;
    text-color:       @selected-active-foreground;
}
element.alternate.normal {
    background-color: @alternate-normal-background;
    text-color:       @alternate-normal-foreground;
}
element.alternate.urgent {
    background-color: @alternate-urgent-background;
    text-color:       @alternate-urgent-foreground;
}
element.alternate.active {
    background-color: @alternate-active-background;
    text-color:       @alternate-active-foreground;
}
scrollbar {
    width:        4px ;
    border:       0;
    handle-color: @normal-foreground;
    handle-width: 8px ;
    padding:      0;
}
mode-switcher {
    border:       2px 0px 0px ;
    border-color: @separatorcolor;
}
button {
    spacing:    0;
    text-color: @normal-foreground;
}
button.selected {
    background-color: @selected-normal-background;
    text-color:       @selected-normal-foreground;
}
inputbar {
    spacing:    0;
    text-color: @normal-foreground;
    padding:    1px ;
}
case-indicator {
    spacing:    0;
    text-color: @normal-foreground;
}
entry {
    spacing:    0;
    text-color: @normal-foreground;
}
prompt {
    spacing:    0;
    text-color: @normal-foreground;
}
inputbar {
    children:   [ prompt,textbox-prompt-colon,entry,case-indicator ];
}

textbox-prompt-colon {
    expand:     false;
    str:        ":";
    margin:     0px 0.3em 0em 0em ;
    text-color: @normal-foreground;
}

window {
    icon-theme: "Papirus";
    show-icons: true;
}