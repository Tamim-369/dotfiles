# i3blocks config file
#
# Please see man i3blocks for a complete reference!
# The man page is also hosted at http://vivien.github.io/i3blocks
#
# List of valid properties:
#
# align
# color
# command
# full_text
# instance
# interval
# label
# min_width
# name
# separator
# separator_block_width
# short_text
# signal
# urgent

# Global properties
#
# The top properties below are applied to every block, but can be overridden.
# Each block command defaults to the script name to avoid boilerplate.
# Change $SCRIPT_DIR to the location of your scripts!
# Global properties
command=$SCRIPT_DIR/$BLOCK_NAME
separator_block_width=0  # Adjust to make it look neat
separator=false
markup=pango

[disk]
command= echo "<span foreground='#5e81ac' background='#1b1f26' size='x-large'></span><span background='#5e81ac'> <span foreground='#D8DEE9' size='large'>  </span> <span foreground='#D8DEE9' size='small' rise='2pt'>/</span> <span size='small' rise='2pt'>$(df -h | grep "/$" | awk '{print $5}')</span>  </span><span background='#5e81ac' foreground='#1b1f26' size='x-large'></span>"
markup=pango
background=#81A1C1
color=#D8DEE9
interval=30

[volume-pulseaudio]
command=$HOME/.config/i3blocks/scripts/volume-pulseaudio
markup=pango
interval=1

[memory]
command=$HOME/.config/i3blocks/scripts/memory
label=<span foreground='#88c0d0' background='#1b1f26' size='x-large'> </span><span background='#88c0d0'> <span foreground='#1b1f26' size='large'></span> </span>
background=#88c0d0
color=#434c5e
markup=pango
interval=2
min_width=memor

[cpu_usage]
command=$HOME/.config/i3blocks/scripts/cpu_usage
interval=1
LABEL=<span foreground='#81A1C1' size='large'>﬙</span> 
markup=pango
min_width=cpucp
DECIMALS=0

[nm-vpn]
command=$HOME/.config/i3blocks/scripts/nm-vpn
markup=pango
background=#81a1c1
interval=5

[date]
command=echo "<span foreground='#81A1C1' size='large'></span> <span size='small' rise='2pt'>$(date +"%Y-%m-%d")</span>"; if [ $button ]; then orage -t; fi
markup=pango
interval=1


[time]
command=echo "<span foreground='#1b1f26' background='#5e81ac' size='x-large'></span><span background='#5e81ac'> <span foreground='#D8DEE9' size='large'> </span> <span size='small' rise='2pt'>$(date +"%H:%M:%S")</span> </span><span background='#5e81ac' foreground='#1b1f26' size='x-large'></span>"
markup=pango
background=#5e81ac
color=#D8DEE9
interval=1

[battery]
command=echo "🔋$(cat /sys/class/power_supply/BAT0/capacity)%"
interval=5
markup=pango
color=#9ab5df

