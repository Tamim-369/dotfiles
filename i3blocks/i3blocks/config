# i3blocks config file

# Please see man i3blocks for a complete reference!

# Global properties

command=$SCRIPT_DIR/$BLOCK_NAME
separator_block_width=0
separator=false
markup=pango

[corner-both]
command=echo "<span size='14pt' > </span>"
color=#f74206
interval=2
separator_block_width=0

[battery]
command=echo "<span><span size='14pt' > 󰂄 </span><span rise='1pt'>$(cat /sys/class/power_supply/BAT0/capacity)%</span> </span>"
interval=5
markup=pango
color=#fcf3f3

[corner-1]
command=echo "<span size='13pt' ></span>"
color=#393636
interval=2
separator_block_width=0

[time]
command=echo "<span foreground='#fcf3f3' background='#fb510d' size='x-large'></span><span background='#393636'> <span foreground='#fcf3f3' size='14pt'> </span><span size='10pt' rise='2pt'>$(date +"%H:%M:%S")</span> </span><span background='#fb510d' foreground='#fcf3f3' size='x-large'></span>"
markup=pango
background=#EECA57
color=#fcf3f3
interval=1
separator_block_width=0

[corner-2]
command=echo "<span size='14pt' ></span>"
color=#393636
interval=2
separator_block_width=0


[date]
command=echo " <span foreground='#ebe9e5' size='14pt'></span> <span size='10pt' rise='2pt' > $(date +"%Y-%m-%d") </span>"; if [ $button ]; then orage -t; fi
markup=pango
color=#ebe9e5
interval=1
separator_block_width=0

[corner-1]
command=echo "<span size='14pt' ></span>"
color=#da3e01
interval=2
separator_block_width=0

[disk]
command=echo "<span foreground='#e9e9e9' background='#da3e01' size='x-large'></span><span background='#da3e01'> <span foreground='#e9e9e9' size='14pt' rise='2pt'>  </span><span foreground='#e9e9e9' size='13pt' rise='2pt'></span><span size='10pt' rise='3pt'>$(df -h | grep "/$" | awk '{print $5}')</span>  </span><span background='#da3e01' foreground='#e9e9e9' size='x-large'></span>"
markup=pango
background=#da3e01
color=#e9e9e9
interval=30
separator_block_width=0

[corner-2]
command=echo "<span size='14pt' ></span>"
color=#da3e01
interval=2
separator_block_width=0
