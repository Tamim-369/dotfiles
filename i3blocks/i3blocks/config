# i3blocks config file

# Please see man i3blocks for a complete reference!

# Global properties

command=$SCRIPT_DIR/$BLOCK_NAME
separator_block_width=0
separator=false
markup=pango

[corner-both]
command=echo "<span size='14pt' > </span>"
color=#F5D979
interval=2
separator_block_width=0

[battery]
command=echo "<span><span size='14pt' > 󰂄 </span><span rise='1pt'>$(cat /sys/class/power_supply/BAT0/capacity)%</span> </span>"
interval=5
markup=pango
color=#F5D979

[corner-1]
command=echo "<span size='13pt' ></span>"
color=#EECA57
interval=2
separator_block_width=0

[time]
command=echo "<span foreground='#2b2f36' background='#EECA57' size='x-large'></span><span background='#EECA57'> <span foreground='#2b2f36' size='14pt'> </span><span size='10pt' rise='2pt'>$(date +"%H:%M:%S")</span> </span><span background='#EECA57' foreground='#2b2f36' size='x-large'></span>"
markup=pango
background=#EECA57
color=#2b2f36
interval=1
separator_block_width=0

[corner-2]
command=echo "<span size='14pt' > </span>"
color=#EECA57
interval=2
separator_block_width=0

[date]
command=echo "<span foreground='#EECA57' size='14pt'></span> <span size='10pt' rise='1pt' > $(date +"%Y-%m-%d") </span>"; if [ $button ]; then orage -t; fi
markup=pango
color=#F5D979
interval=1
separator_block_width=0

[corner-1]
command=echo "<span size='14pt' ></span>"
color=#EECA57
interval=2
separator_block_width=0

[disk]
command=echo "<span foreground='#2b2f36' background='#EECA57' size='x-large'></span><span background='#EECA57'> <span foreground='#2b2f36' size='14pt' rise='2pt'>  </span><span foreground='#2b2f36' size='13pt' rise='2pt'></span><span size='10pt' rise='3pt'>$(df -h | grep "/$" | awk '{print $5}')</span>  </span><span background='#EECA57' foreground='#2b2f36' size='x-large'></span>"
markup=pango
background=#EECA57
color=#2b2f36
interval=30
separator_block_width=0

[corner-2]
command=echo "<span size='14pt' ></span>"
color=#EECA57
interval=2
separator_block_width=0
